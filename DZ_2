        self.val = val
        self.next = None


def sum_array2(a,b):
    node = ListNode(0)
    result = node

    while a and b:
        if a.val <= b.val:
            result.next = a
            a=a.next
            result = result.next
        else:
            result.next = b
            b=b.next
            result = result.next
    if a == None:
        result.next = b
    else:
        result.next = a

    return node.next
