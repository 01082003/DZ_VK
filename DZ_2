class ListNode:
    def __init__(self,val):
        self.val = val
        self.next = None

def remove_elements(head, value):
    dummy = ListNode()
    dummy.next = head
    prev = dummy
    current = head

    while current != None:
        if current.val == value:
            prev.next = current.next
        else:
            prev = current
        current = current.next

    return dummy.next
# Мы создаем пустой элемент и задаем его как предшествующий голове списка, тогда при удалении головы, ее место займет нулевой элемент
# Когда мы нашли требуемую к удалению ячейку, мы просто меняем указатель предшесвующей ей на следующую


