def hesCycle(head):
    if head == None or head.next == None:
        return 'false'
    slow = head
    fast = head.next

    while slow != fast:
        if fast == None or fast.next == None:
            return 'false'
        slow = slow.next
        fast = fast.next.next

    return 'true'



# ЗАДАЧА 2
def reverseLinkedList(head):
    prev = None
    current = head

    while current != None:
        next = current.next
        current.next = prev
        prev = current
        current = next

    head = prev
    return head



