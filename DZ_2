# ЗАДАЧА 10
 def sum_target(a, target):
    if len(a) <= 1:
        return False

    i, j = 0, len(a)-1

    while i < j:
        if a[i] + a[j] == target:
            return True
        elif a[i] + a[j] > target:
            j -= 1
        else:
            i += 1

    return False

# Подход работает за O(N) т к проход по всем членам заниамет линейное время, а сложение O(1)


