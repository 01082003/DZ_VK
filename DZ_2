def reverseLinkedList(head):
    prev = None
    current = head

    while current != None:
        next = current.next
        current.next = prev
        prev = current
        current = next

    head = prev
    return head
# На каждом шаге предыдущий узел становится следующим, аглоритм работает за линейное время т к мы один раз проходимся по списку и меняем в нем указатели


