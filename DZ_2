def remove(arr):
    if len(arr) == 0:
        return []
    i, j  = 0, 1
    while j < len(arr):
        if arr[i] == arr[j]:
            j += 1
        else:
            arr[i+1] = arr[j]
            i += 1
            j += 1
    return arr[:i+1]

