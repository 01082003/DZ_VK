def is_palindrome(s):
    stack = []
    for char in s:
        stack.append(char)

    for char in s:
        if char != stack.pop():
            return 'false'

    return 'true'


def is_palindrome2(s):
    left = 0
    right = len(s) - 1

    while left<right:
        if s[left] != s[right]:
            return 'false'
        left += 1
        right -= 1

    return 'true'


