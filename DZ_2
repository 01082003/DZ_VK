from collections import deque

def is_subsequence(a,b):
    q = deque()
    for el in a:
        q.append(el)

    for el in b:
        if q and q[0] == el:
            q.popleft()

    return len(q) == 0

def is_subsequence2(a,b):
    i,j = 0,0
    while i < len(a) and j < len(b):
        if a[i] == b[j]:
            i += 1
        j += 1
    return i == len(a)


