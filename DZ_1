#Задача 4
def reverseArray(arr, left, right):
    while left<right:
        arr[left], arr[right] = arr[right], arr[left]
        left+=1
        right-=1
    return arr

def solution(arr, k):
    n = len(arr)
    if n==0:
        return arr
    k %= n
    if k == 0:
        return arr
    reverseArray(arr,0, n-1)
    reverseArray(arr, 0, k - 1)
    reverseArray(arr, k, n - 1)
    return arr


def solution2(arr, k):
    n = len(arr)
    if n == 0:
        return arr
    k %= n
    if k == 0:
        return arr
    arr.reverse()
    arr[:k] = arr[:k][::-1]
    arr[k:] = arr[k:][::-1]
    return arr


