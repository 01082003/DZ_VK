def summa(a, target):
    heshmapb = {}
    for i in a:
        heshmapb[i] = heshmapb.get(i, 0)+1
    for i in a:
        razn = target - i
        if heshmapb.get(razn, 0) > 0  and (razn != i or heshmapb.get(razn, 0) > 1):
            return i, razn

    return None



# ЗАДАЧА 6
def annograms(strs):
    slova = {}
    for s in strs:
        summ = 1
        for letter in s:
            summ = summ * ((ord(letter)+5)%131)
        slova.setdefault(summ, []).append(s)
    return list(slova.values())
