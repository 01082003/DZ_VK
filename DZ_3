def difference(a,b):
    heshmapb = {}
    for i in b:
        heshmapb[i] = heshmapb.get(i,0) + 1

    for j in a:
        heshmapb[j] = heshmapb.get(j,0) - 1

    for letter, count in heshmapb.items():
        if count>0:
            return letter
    return''

