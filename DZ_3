def korm(animals, food):
    if len(animals) == 0 or len(food) == 0:
        return 0
    animals.sort()
    food.sort()

    count = 0
    for f in food:
        if len(animals) > count:
            if f>=animals[count]:
                count += 1

        if count == len(animals):
            break

    return count


