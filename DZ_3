def kserox(n, x, y):
    first=min(x,y)
    l, r = 0, (n-1)*min(x,y)
    while l <= r:
        mid = (l+r)//2
        if mid//x+mid//y == n-1:
            return mid+first
        elif mid//x+mid//y < n-1:
            l = mid+1
        else:
            r = mid-1
    return l-1+first


n = int(input())
x = int(input())
y = int(input())

print(kserox(n, x, y))


